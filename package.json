{
  "name": "quoridoraner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser.mjs",
    "bench": "tsx bench/bench.ts",
    "selfplay": "tsx selfplay/run.ts",
    "selfplay:report": "tsx selfplay/report.ts",
    "bench:kernels": "tsx bench/kernels.ts",
    "train": ".venv/bin/python training/train.py",
    "train:bot": ".venv/bin/python training/bot.py",
    "train:test": ".venv/bin/python -m unittest discover -s training -p 'test_*.py' -v",
    "train:bench": ".venv/bin/python training/benchmark.py",
    "train:native:build": "python3 training/native/build.py",
    "train:native:bench": "tsx training/native-benchmark.ts",
    "train:direct:build": ".venv/bin/python training/native/build_direct.py",
    "train:bench:pipeline": ".venv/bin/python training/benchmark_pipeline.py",
    "dashboard": "npm run build && .venv/bin/python training/dashboard.py"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "simple-statistics": "^7.12.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
